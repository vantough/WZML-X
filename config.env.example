# Copy to config.env and protect it with chmod 600.
# Prowlarr's first start generates the API key. Startup syncs it here automatically.
PROWLARR_URL=http://prowlarr:9696
PROWLARR_USERNAME=
PROWLARR_PASSWORD=
PROWLARR_API_KEY=
PROWLARR__HOST__ALLOWEDHOSTS=localhost,127.0.0.1,prowlarr,wzmlx-v3-prowlarr,SERVER_PUBLIC_IP
